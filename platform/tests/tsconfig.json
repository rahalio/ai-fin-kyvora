{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@kyvora/core/*/models/index.js": ["../../packages/core/src/*/index"],
      "@kyvora/core/*/models/index": ["../../packages/core/src/*/index"],
      "@kyvora/core": ["../../packages/core/src/index.ts"],
      "@kyvora/core/*": ["../../packages/core/src/*"],
      "@kyvora/services": ["../services/src/index.ts"],
      "@kyvora/services/*": ["../services/src/*"],
      "@kyvora/adapters": ["../adapters/src/index.ts"],
      "@kyvora/adapters/*": ["../adapters/src/*"],
      "@kyvora/api-server": ["../api-server/src/index.ts"],
      "@kyvora/api-server/*": ["../api-server/src/*"],
      "@kyvora/api-server/domains/ai": ["../api-server/src/domains/ai/dependencies/ai-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/analytics": ["../api-server/src/domains/analytics/dependencies/analytics-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/auth": ["../api-server/src/domains/auth/dependencies/auth-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/compliance": ["../api-server/src/domains/compliance/dependencies/compliance-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/content": ["../api-server/src/domains/content/dependencies/content-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/distribution": ["../api-server/src/domains/distribution/dependencies/distribution-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/document": ["../api-server/src/domains/document/dependencies/document-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/due-diligence": ["../api-server/src/domains/due-diligence/dependencies/due-diligence-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/eligibility": ["../api-server/src/domains/eligibility/dependencies/eligibility-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/escrow": ["../api-server/src/domains/escrow/dependencies/escrow-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/identity": ["../api-server/src/domains/identity/dependencies/identity-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/investment": ["../api-server/src/domains/investment/dependencies/investment-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/market-primary": ["../api-server/src/domains/market-primary/dependencies/market-primary-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/market-secondary": ["../api-server/src/domains/market-secondary/dependencies/market-secondary-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/notification": ["../api-server/src/domains/notification/dependencies/notification-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/observability": ["../api-server/src/domains/observability/dependencies/observability-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/offering": ["../api-server/src/domains/offering/dependencies/offering-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/payment": ["../api-server/src/domains/payment/dependencies/payment-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/portfolio": ["../api-server/src/domains/portfolio/dependencies/portfolio-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/property": ["../api-server/src/domains/property/dependencies/property-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/provider": ["../api-server/src/domains/provider/dependencies/provider-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/support": ["../api-server/src/domains/support/dependencies/support-ddd.dependencies.ts"],
      "@kyvora/api-server/domains/valuation": ["../api-server/src/domains/valuation/dependencies/valuation-ddd.dependencies.ts"],
      "@kyvora/factories/*": ["./src/*/factories"],
      "@kyvora/tests/shared": ["./src/_shared"],
      "@kyvora/tests/shared/*": ["./src/_shared/*"],
      "@platform/tests/shared": ["./src/_shared"],
      "@platform/tests/shared/*": ["./src/_shared/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/dist", "reports"]
}
